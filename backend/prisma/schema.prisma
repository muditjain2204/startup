datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  CONTRACTOR
  USER
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  SUSPENDED
  BLOCKED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DamageCategory {
  POTHOLE
  ALLIGATOR_CRACK
  SURFACE_BREAK
  RUTTING
  EROSION
  OTHER
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  SUBMITTED
  AI_PROCESSED
  VERIFIED
  REJECTED
  CONTRACTED
  REPAIRED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ContractStatus {
  DRAFT
  OPEN_FOR_BIDDING
  UNDER_REVIEW
  AWARDED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ProjectStatus {
  AWARDED
  ACCEPTED
  IN_PROGRESS
  SUBMITTED_FOR_INSPECTION
  INSPECTION_APPROVED
  COMPLETED
}

enum RepairStage {
  BEFORE_REPAIR
  IN_PROGRESS
  AFTER_REPAIR
  INSPECTION
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  phone        String?
  role         UserRole    @default(USER)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  contractorProfile ContractorProfile?
  reports           DamageReport[]      @relation("UserReports")
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
}

model ContractorProfile {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String
  gstNumber        String?
  licenseNumber    String?
  address          String
  latitude         Float
  longitude        Float
  operatingRadiusKm Float             @default(25.0)
  experienceYears  Int                @default(0)
  machinery        String             // JSON string or comma-separated list
  workforceCount   Int                @default(0)
  status           VerificationStatus @default(PENDING)
  rating           Float              @default(5.0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  documents        ContractorDocument[]
  bids             Bid[]
  repairProjects   RepairProject[]

  @@index([status])
  @@index([latitude, longitude])
}

model ContractorDocument {
  id           String            @id @default(uuid())
  contractorId String
  contractor   ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  documentType String            // GST, LICENSE, EXPERIENCE, CERTIFICATE
  title        String
  fileUrl      String
  verified     Boolean           @default(false)
  createdAt    DateTime          @default(now())
}

model QRCode {
  id           String         @id @default(uuid())
  code         String         @unique
  locationName String
  latitude     Float
  longitude    Float
  isActive     Boolean        @default(true)
  scanCount    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  scans        QRScan[]
  reports      DamageReport[]

  @@index([code])
}

model QRScan {
  id             String    @id @default(uuid())
  qrCodeId       String
  qrCode         QRCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  scannedAt      DateTime  @default(now())
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  userAgent      String?
  ipAddress      String?
}

model DamageReport {
  id             String          @id @default(uuid())
  reportNumber   String          @unique
  reporterId     String?
  reporter       User?           @relation("UserReports", fields: [reporterId], references: [id], onDelete: SetNull)
  qrCodeId       String?
  qrCode         QRCode?         @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  title          String?
  description    String?
  latitude       Float
  longitude      Float
  address        String?
  city           String?         @default("Delhi NCR")
  damageCategory DamageCategory  @default(POTHOLE)
  status         ReportStatus    @default(SUBMITTED)
  adminNotes     String?
  duplicateOfId  String?
  duplicateOf    DamageReport?   @relation("ReportDuplicates", fields: [duplicateOfId], references: [id])
  duplicates     DamageReport[]  @relation("ReportDuplicates")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  detections     DamageDetection[]
  evidence       DamageEvidence[]
  repairContract RepairContract?

  @@index([status])
  @@index([damageCategory])
  @@index([latitude, longitude])
}

model DamageDetection {
  id                String        @id @default(uuid())
  reportId          String
  report            DamageReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  damageCategory    String
  confidence        Float
  severity          SeverityLevel @default(MEDIUM)
  estimatedAreaSqM  Float?
  estimatedDepthCm  Float?
  boundingBoxJson   String?       // JSON array of boxes [ymin, xmin, ymax, xmax]
  frameTimestamp    Float?
  annotatedImageUrl String?
  createdAt         DateTime      @default(now())

  @@index([reportId])
}

model DamageEvidence {
  id           String       @id @default(uuid())
  reportId     String
  report       DamageReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  mediaType    MediaType    @default(IMAGE)
  mediaUrl     String
  thumbnailUrl String?
  fileSize     Int?
  mimeType     String?
  gpsLat       Float?
  gpsLng       Float?
  capturedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([reportId])
}

model DetectionThreshold {
  id                          String   @id @default(uuid())
  minConfidence               Float    @default(0.65)
  minPotholeAreaSqM           Float    @default(0.05)
  minEstimatedDepthCm         Float    @default(3.0)
  highSeverityDepthCm         Float    @default(8.0)
  maxGpsAccuracyToleranceM    Float    @default(30.0)
  duplicateDistanceThresholdM Float    @default(25.0)
  updatedAt                   DateTime @updatedAt
}

model RepairContract {
  id                 String         @id @default(uuid())
  contractNumber     String         @unique
  damageReportId     String         @unique
  damageReport       DamageReport   @relation(fields: [damageReportId], references: [id], onDelete: Restrict)
  title              String
  description        String
  repairRequirements String
  estimatedBudget    Float
  targetLatitude     Float
  targetLongitude    Float
  eligibleRadiusKm   Float          @default(25.0)
  biddingDeadline    DateTime
  status             ContractStatus @default(OPEN_FOR_BIDDING)
  awardedBidId       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  bids               Bid[]
  repairProject      RepairProject?

  @@index([status])
  @@index([targetLatitude, targetLongitude])
}

model Bid {
  id              String            @id @default(uuid())
  contractId      String
  contract        RepairContract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractorId    String
  contractor      ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  amount          Float
  estimatedDays   Int
  proposalDetails String?
  status          BidStatus         @default(SUBMITTED)
  submittedAt     DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([contractId, contractorId])
  @@index([contractId])
  @@index([status])
}

model RepairProject {
  id                 String            @id @default(uuid())
  contractId         String            @unique
  contract           RepairContract    @relation(fields: [contractId], references: [id], onDelete: Restrict)
  contractorId       String
  contractor         ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  status             ProjectStatus     @default(AWARDED)
  startDate          DateTime?
  completionDate     DateTime?
  inspectionNotes    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  updates            RepairUpdate[]

  @@index([contractorId])
  @@index([status])
}

model RepairUpdate {
  id          String        @id @default(uuid())
  projectId   String
  project     RepairProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage       RepairStage   @default(IN_PROGRESS)
  notes       String
  photoUrls   String        // JSON array of strings
  uploadedAt  DateTime      @default(now())

  @@index([projectId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // REPORT_UPDATE, CONTRACT_OPEN, BID_WON, etc.
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
}

