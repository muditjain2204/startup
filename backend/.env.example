# ==========================================
# SMARTROAD AI — BACKEND ENVIRONMENT TEMPLATE
# ==========================================

# 1. Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# 2. Database (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://user:password@localhost:5432/smartroad_ai?sslmode=prefer"

# 3. Security & Authentication (JWT)
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# 4. AI Computer Vision Microservice
AI_SERVICE_URL="http://localhost:8000"
AI_PROVIDER="SIMULATED_CV"
YOLO_MODEL_PATH="./models/road_potholes.pt"

# 5. Cloud Media Storage (Cloudinary)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 6. Maps, Satellite Imagery & Geocoding
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# 7. SMS & WhatsApp Notifications (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""

# 8. Alternative SMS Gateway (India MSG91 / Optional)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="SMTRAD"

# 9. Cron Job & Automated Maintenance
CRON_SCHEDULE="* * * * *"
CRON_SECRET="smartroad-cron-secret-key-2026"
CRON_JOB_URL="http://localhost:5001/api/cron/run"
